---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/editorial.css';
import '../styles/motion.css';
import { profile, experiences, works, certificates, awards } from '../data/portfolio';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/images/nur-hidayati-social-v1.jpg', Astro.site);
const socialTitle = 'Nur Hidayati | HSE Administrator';
const socialDescription = 'Kenali pengalaman Nur dalam administrasi, pengelolaan data, komunikasi publik, dan kerja tim.';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="Nur Hidayati" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:secure_url" content={socialImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portfolio Nur Hidayati — HSE Administrator, Administrasi, Data, dan Komunikasi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Portfolio Nur Hidayati — HSE Administrator" />
    <meta name="description" content="Nur Hidayati — HSE Administrator dengan pengalaman dalam administrasi, pengelolaan data, komunikasi publik, dan media organisasi." />
    <meta name="theme-color" content="#f2f2ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Nur Hidayati — Administrasi & Komunikasi</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    <header class="site-header"><div class="container header-inner">
      <a class="brand" href="#beranda" aria-label="Nur Hidayati, kembali ke beranda"><span class="brand-mark">NH<span>.</span></span><span class="brand-caption">PORTFOLIO / 2026</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">☰</span></button>
      <nav id="navigation" aria-label="Navigasi utama"><a href="#karya">Karya</a><a href="#pengalaman">Pengalaman</a><a href="#tentang">Tentang</a><a href="#pencapaian">Pencapaian</a><a class="nav-contact" href="#kontak">Kontak <span aria-hidden="true">↗</span></a></nav>
    </div></header>

    <main id="main">
      <section class="hero" id="beranda" aria-labelledby="hero-title">
        <div class="hero-background"><img src={profile.portrait} alt="Potret Nur Hidayati" width="1600" height="900" fetchpriority="high" decoding="async" /></div>
        <div class="container hero-inner"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-rule"></span> PENAJAM PASER UTARA, KALIMANTAN TIMUR</p><h1 id="hero-title">Nur<br /><em>Hidayati</em><span class="title-dot">.</span></h1><div class="hero-intro"><p class="role-label">HSE ADMINISTRATOR · SARJANA TERAPAN BISNIS</p><p class="hero-statement">Sehari-hari mengurus administrasi K3. Di kesempatan lain, membawakan acara dan bekerja bersama tim kreatif.</p></div><div class="hero-actions"><a class="button-primary" href="#karya">Lihat pekerjaan saya <span aria-hidden="true">↗</span></a><a class="text-link" href="/cv-nur-hidayati.pdf" download>Unduh CV <span aria-hidden="true">↓</span></a></div></div>
          <aside class="hero-note" aria-label="Pekerjaan saat ini"><span>SAAT INI</span><strong>HSE Administrator</strong><p>PT ITCI Kartika Utama · sejak 2026</p></aside><div class="hero-footer"><a class="hero-scroll" href="#karya">Kenali pekerjaan saya <span aria-hidden="true">↓</span></a><p>ADMINISTRASI · KOMUNIKASI · KREATIVITAS</p></div>
        </div>
      </section>

      <section class="intro-strip" aria-label="Ringkasan profil"><div class="container intro-strip-inner"><p>Dari merapikan data hingga memandu acara.<br />Saya senang membuat pekerjaan <em>lebih teratur dan mudah dipahami.</em></p><a href="#tentang">Tentang saya <span aria-hidden="true">↗</span></a></div></section>

      <section class="section selected-work container" id="karya" aria-labelledby="work-title"><div class="section-heading"><div><p class="eyebrow">01 / PEKERJAAN TERPILIH</p><h2 id="work-title">Pengalaman dalam<br /><em>praktik.</em></h2></div><p>Beberapa bentuk kontribusi saya, dari data dan laporan hingga panggung dan media publikasi.</p></div><div class="case-list">{works.map((work, i) => <article class="case-item"><div class="case-index">0{i + 1} <span>/ 03</span></div><div class="case-main"><p class="case-category">{work.category}</p><h3>{work.title}</h3><p class="case-description">{work.description}</p><details class="case-details"><summary>Detail pekerjaan <span class="plus" aria-hidden="true">+</span></summary><div class="case-detail-body"><div><h4>Konteks</h4><p>{work.context}</p></div><div><h4>Yang saya kerjakan</h4><p>{work.contribution}</p></div><div><h4>Hasil</h4><p>{work.result}</p></div></div></details></div><div class:list={['case-visual', `case-visual-${i + 1}`]}>{work.image ? <a class="photo-link" href={work.image} target="_blank" rel="noopener noreferrer" aria-label={"Buka dokumentasi: " + work.title}><img src={work.image} alt={work.alt} loading="lazy" width={i === 1 ? 2513 : 6000} height={i === 1 ? 4468 : 3376} /><span aria-hidden="true">Lihat foto ↗</span></a> : <div class="data-note"><span class="data-note-label">CATATAN MAGANG / 2025</span><strong>160<span>+</span></strong><p>entri kunjungan berobat karyawan diolah setiap bulan.</p><ol aria-label="Lingkup pekerjaan"><li>01 / Entri data</li><li>02 / Visualisasi</li><li>03 / Laporan audit</li></ol><small>Ringkasan pengalaman · dokumentasi laporan menyusul</small></div>}</div></article>)}</div></section>

      <section class="section experience-section" id="pengalaman" aria-labelledby="experience-title"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / RIWAYAT PROFESIONAL</p><h2 id="experience-title">Perjalanan<br /><em>profesional.</em></h2></div><p>Pengalaman lintas administrasi, keselamatan kerja, dan komunikasi acara.</p></div><div class="experience-list">{experiences.map((item, i) => <article class="experience-item"><div class="experience-year"><span>0{i + 1}</span><span>{item.date}</span></div><div class="experience-body"><h3>{item.role}</h3><p class="experience-company">{item.company}</p><p>{item.description}</p><ul>{item.points.map(point => <li>{point}</li>)}</ul><div class="experience-tags" aria-label="Bidang pekerjaan">{item.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div></div></section>

      <section class="section about-section container" id="tentang" aria-labelledby="about-title"><div class="about-left"><p class="eyebrow">03 / TENTANG SAYA</p><h2 id="about-title">Teliti saat mengolah.<br /><em>Jelas saat menyampaikan.</em></h2><p class="about-lead">Saya lulusan Sarjana Terapan Bisnis dari Politeknik Negeri Samarinda. Pekerjaan administrasi mengajarkan saya pentingnya data dan dokumen yang tertata; pengalaman organisasi dan MC melatih saya untuk menyampaikannya dengan baik.</p><div class="education"><span>PENDIDIKAN / 2021–2025</span><h3>Politeknik Negeri Samarinda</h3><p>Sarjana Terapan Bisnis · Administrasi Bisnis</p><strong>IPK 3,89 / 4,00</strong></div></div><div class="about-right"><div class="about-stat"><strong>160<span>+</span></strong><p>entri data kunjungan berobat karyawan yang diolah per bulan selama magang.</p></div><div class="about-stat"><strong>50<span>+</span></strong><p>desain poster, banner, dan kampanye media sosial untuk kegiatan organisasi.</p></div><div class="about-stat"><strong>50–1.000</strong><p>rentang audiens dalam pengalaman membawakan berbagai acara sebagai MC.</p></div></div></section>

      <section class="leadership-section"><div class="container leadership-grid"><div><p class="eyebrow">04 / DI LUAR PEKERJAAN UTAMA</p><h2>Belajar memimpin<br /><em>lewat kerja tim.</em></h2></div><div class="leadership-copy"><p>Di UKM PPKM, saya memulai sebagai Wakil Kepala Departemen Media dan Informasi sebelum menjadi Kepala Departemen. Saya menyusun rencana konten, membagi tugas, membimbing anggota, dan terlibat dalam koordinasi dua kompetisi karya tulis ilmiah.</p><div class="leadership-dates"><div><span>2023</span><p>Wakil Kepala Departemen Media dan Informasi</p></div><div><span>2023–2024</span><p>Kepala Departemen Media dan Informasi</p></div></div></div></div></section>

      <section class="section achievement-section container" id="pencapaian" aria-labelledby="achievement-title"><div class="section-heading"><div><p class="eyebrow">05 / PENGAKUAN & PEMBELAJARAN</p><h2 id="achievement-title">Pencapaian &<br /><em>proses belajar.</em></h2></div><p>Penghargaan dan sertifikasi yang melengkapi pengalaman kerja saya.</p></div><div class="achievement-grid"><div class="awards-column"><h3 class="column-label">PENGHARGAAN <span>01 — 05</span></h3>{awards.map(([year,title,detail]) => <div class="award-row"><span class="award-year">{year}</span><div><h4>{title}</h4><p>{detail}</p></div></div>)}</div><div class="cert-column"><h3 class="column-label">SERTIFIKASI <span>01 — 02</span></h3>{certificates.map(c => <article class="certificate-item"><div class="certificate-thumb" style={c.image ? `--certificate-ratio: ${c.width} / ${c.height}` : undefined}>{c.image ? <a href={c.document || c.image} target="_blank" rel="noopener noreferrer" aria-label={'Lihat sertifikat '+c.title+' ukuran penuh'}><img src={c.image} alt={'Sertifikat '+c.title} loading="lazy" width={c.width} height={c.height} /></a> : <div class="certificate-empty" aria-label="Gambar sertifikat akan ditambahkan"><span aria-hidden="true">↗</span></div>}</div><div><span class="certificate-issuer">{c.issuer} / {c.date}</span><h4>{c.title}</h4>{c.image && <a class="certificate-view" href={c.document || c.image} target="_blank" rel="noopener noreferrer">Lihat sertifikat ↗</a>}</div></article>)}</div></div></section>

      <section class="skills-section"><div class="container skills-grid"><div><p class="eyebrow">06 / PERANGKAT KERJA</p><h2>Kemampuan yang<br /><em>saya gunakan.</em></h2></div><div class="skill-list"><div><span>01</span><div><h3>Administrasi & data</h3><p>Document control, pengarsipan, entri data, pelaporan, visualisasi data.</p></div></div><div><span>02</span><div><h3>Komunikasi & organisasi</h3><p>Public speaking, koordinasi tim, manajemen waktu, pemecahan masalah.</p></div></div><div><span>03</span><div><h3>Aplikasi</h3><p>Microsoft Office, Google Workspace, Notion, dan Canva.</p></div></div><div><span>04</span><div><h3>Bahasa</h3><p>Bahasa Indonesia (penutur asli), Bahasa Inggris (TOEFL 443).</p></div></div></div></div></section>

      <section class="contact-section container" id="kontak"><p class="eyebrow">07 / KONTAK</p><h2>Mari mulai<br /><em>percakapan.</em></h2><div class="contact-bottom"><p>Saya terbuka untuk percakapan tentang peluang profesional dan kolaborasi.</p><a class="contact-email" href={'mailto:'+profile.email}>{profile.email} <span aria-hidden="true">↗</span></a></div><div class="contact-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">Terhubung di LinkedIn ↗</a><a href="/cv-nur-hidayati.pdf" download>Unduh curriculum vitae ↓</a></div></section>
    </main>

    <footer class="site-footer"><div class="container footer-inner"><span class="footer-name">Nur Hidayati<span>.</span></span><div><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="/cv-nur-hidayati.pdf" download>Unduh CV ↓</a><a href="#beranda">Kembali ke atas ↑</a></div><p>© {new Date().getFullYear()} Nur Hidayati</p></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); });
      nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
      window.matchMedia('(min-width: 781px)').addEventListener('change', closeMenu);
      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealItems = document.querySelectorAll<HTMLElement>('.section-heading, .case-item, .experience-item, .about-left, .about-stat, .leadership-grid > div, .award-row, .certificate-item, .skills-grid > div, .contact-section > *, .intro-strip-inner');
      let observer: IntersectionObserver | undefined;
      function enableReveals() {
        observer?.disconnect();
        revealItems.forEach(item => item.classList.remove('reveal-pending', 'reveal-ready'));
        if (motionPreference.matches || !('IntersectionObserver' in window)) return;
        observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px -35px 0px' });
        revealItems.forEach(item => {
          if (item.getBoundingClientRect().top < window.innerHeight || item.classList.contains('is-visible')) return;
          item.classList.add('reveal-pending', 'reveal-ready');
          observer?.observe(item);
        });
      }
      enableReveals();
      motionPreference.addEventListener('change', enableReveals);
      document.addEventListener('focusin', event => {
        if (event.target instanceof Element) event.target.closest('.reveal-pending')?.classList.add('is-visible');
      });
      window.addEventListener('beforeprint', () => {
        revealItems.forEach(item => item.classList.add('is-visible'));
      });
    </script>
  </body>
</html>
